# Supabase konfiguracija (javni frontend ključevi - sigurni uz RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only varijable za Vercel Serverless funkcije (/api/*) — NIKADA ne stavljati VITE_ prefiks!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
INTERVALS_AUTH_SECRET=change-this-to-a-long-random-secret-string

# Google Gemini API ključ (samo na serveru za /api/gemini; na Vercelu NE postavljaj VITE_GEMINI_API_KEY!)
GEMINI_API_KEY=your-gemini-api-key

# Opcionalno: dodatne dopuštene domene za CORS (odvojene zarezom, npr. https://ergvibe.app)
ALLOWED_ORIGINS=https://ergvibe.vercel.app
