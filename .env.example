# Supabase konfiguracija (baza podataka i autentifikacija)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API ključ (za sigurni Vercel backend proxy /api/gemini - bez VITE_ prefiksa!)
GEMINI_API_KEY=your-gemini-api-key

# Opcionalno za lokalni rad podržava se i:
VITE_GEMINI_API_KEY=your-gemini-api-key
